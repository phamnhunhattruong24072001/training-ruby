<%= form_with model: @user, url: @user.persisted? ? user_update_path(@user) : user_create_path, local: true do |f| %>
<div class="card-body">
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(user.errors.count, "lỗi") %>:</h6>
      <ul>
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="mb-3 col-6">
      <%= f.label :email, "Email" %>
      <%= f.text_field :email, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :username, "Username" %>
      <%= f.text_field :username, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :fullname, "Fullname" %>
      <%= f.text_field :fullname, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :display_name, "Display name" %>
      <%= f.text_field :display_name, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :phone, "Phone number" %>
      <%= f.text_field :phone, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :birth_day, "Birth day" %>
      <%= f.date_field :birth_day, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
    <%= f.label :team_id, "Team" %>
    <%= f.collection_select :team_id, @teams, :id, :name, { prompt: "Select a team" }, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :position_id, "Position" %>
      <%= f.collection_select :position_id, @positions, :id, :name, { prompt: "Select a position" }, class: "form-control" %>
    </div>

    <div class="mb-3 col-6">
      <%= f.label :role_id, "Role" %>
      <%= f.collection_select :role_id, @roles, :id, :name, { prompt: "Select a role" }, class: "form-control" %>
    </div>

    <div class="mt-3 col-12">
      <%= f.submit class: "btn btn-success" %>
      <%= link_to "Quay lại", user_list_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
<% end %>
