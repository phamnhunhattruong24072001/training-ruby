<%= form_with model: @user, url: @user.persisted? ? user_update_path(@user) : user_create_path, local: true do |f| %>
<div class="card-body">
  <div class="row">
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :name, "Email" %>
            <%= f.text_field :email, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:email].any?}", placeholder: "Email" %>
            <% if @form.errors[:email].any? %>
                <div class="invalid-feedback"><%= @form.errors[:email].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :name, "Username" %>
            <%= f.text_field :username, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:username].any?}", placeholder: "Username" %>
            <% if @form.errors[:username].any? %>
                <div class="invalid-feedback"><%= @form.errors[:username].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :name, "Fullname" %>
            <%= f.text_field :fullname, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:fullname].any?}", placeholder: "Fullname" %>
            <% if @form.errors[:fullname].any? %>
                <div class="invalid-feedback"><%= @form.errors[:fullname].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :name, "Display name" %>
            <%= f.text_field :display_name, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:display_name].any?}", placeholder: "Display name" %>
            <% if @form.errors[:display_name].any? %>
                <div class="invalid-feedback"><%= @form.errors[:display_name].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :name, "Phone Number" %>
            <%= f.text_field :phone, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:phone].any?}", placeholder: "Phone Number" %>
            <% if @form.errors[:phone].any? %>
                <div class="invalid-feedback"><%= @form.errors[:phone].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :birth_day, "Birth Day" %>
            <%= f.text_field :birth_day, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:birth_day].any?}", placeholder: "Birth Day" %>
            <% if @form.errors[:birth_day].any? %>
                <div class="invalid-feedback"><%= @form.errors[:birth_day].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :team_id, "Team" %>
            <%= f.collection_select :team_id, @teams, :id, :name, { prompt: "Select a team" }, class: "form-control #{'is-invalid' if @form.errors[:team_id].any?}" %>
            <% if @form.errors[:team_id].any? %>
                <div class="invalid-feedback"><%= @form.errors[:team_id].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :position_id, "Position" %>
            <%= f.collection_select :position_id, @positions, :id, :name, { prompt: "Select a position" }, class: "form-control #{'is-invalid' if @form.errors[:position_id].any?}" %>
            <% if @form.errors[:position_id].any? %>
                <div class="invalid-feedback"><%= @form.errors[:position_id].first %></div>
            <% end %>
        </div>
    </div>

    <div class="mb-3 col-6">
        <div class="form-group mb-3">
            <%= f.label :role_id, "Role" %>
            <%= f.collection_select :role_id, @roles, :id, :name, { prompt: "Select a role" }, class: "form-control #{'is-invalid' if @form.errors[:role_id].any?}" %>
            <% if @form.errors[:role_id].any? %>
                <div class="invalid-feedback"><%= @form.errors[:role_id].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mt-3 col-12">
      <%= f.submit "Submit", class: "btn btn-success" %>
      <%= link_to "Quay lại", user_list_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
<% end %>
