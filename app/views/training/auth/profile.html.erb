<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Profile</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">Profile</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <% flash.each do |type, message| %>
                <% alert_class = type == "notice" ? "success" : "danger" %>
                    <div class="alert alert-<%= alert_class %>">
                        <%= message %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- left column -->
            <div class="col-md-12">
            <!-- general form elements -->
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Profile</h3>
                </div>
                <!-- /.card-header -->
                <!-- form start -->
                <%= form_with model: @user, url: update_profile_path, local: true do |f| %>
                <div class="card-body">
                    <div class="row">
                        <div class="mb-3 col-6">
                            <div class="form-group mb-3">
                                <%= f.label :name, "Full name" %>
                                <%= f.text_field :fullname, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:fullname].any?}", placeholder: "Full name" %>
                                <% if @form.errors[:fullname].any? %>
                                    <div class="invalid-feedback"><%= @form.errors[:fullname].first %></div>
                                <% end %>
                            </div>
                        </div>

                        <div class="mb-3 col-6">
                            <div class="form-group mb-3">
                                <%= f.label :name, "Display Nam" %>
                                <%= f.text_field :display_name, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:display_name].any?}", placeholder: "Display Nam" %>
                                <% if @form.errors[:display_name].any? %>
                                    <div class="invalid-feedback"><%= @form.errors[:display_name].first %></div>
                                <% end %>
                            </div>
                        </div>

                        <div class="mb-3 col-6">
                            <div class="form-group mb-3">
                                <%= f.label :name, "Phone number" %>
                                <%= f.text_field :phone, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:phone].any?}", placeholder: "Phone number" %>
                                <% if @form.errors[:phone].any? %>
                                    <div class="invalid-feedback"><%= @form.errors[:phone].first %></div>
                                <% end %>
                            </div>
                        </div>

                        <div class="mb-3 col-6">
                            <div class="form-group mb-3">
                                <%= f.label :name, "Birth Day" %>
                                <%= f.date_field :birth_day, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:birth_day].any?}", placeholder: "Birth Day" %>
                                <% if @form.errors[:birth_day].any? %>
                                    <div class="invalid-feedback"><%= @form.errors[:birth_day].first %></div>
                                <% end %>
                            </div>
                        </div>

                        <div class="mt-3 col-12">
                            <%= f.submit "Save", class: "btn btn-success" %>
                        </div>
                    </div>
                </div>
                <% end %>
            </div>
            <!-- /.card -->
            </div>
            <!--/.col (left) -->
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->