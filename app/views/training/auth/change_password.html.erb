<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Change password</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">Change password</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <% flash.each do |type, message| %>
                    <% alert_class = type == "notice" ? "success" : "danger" %>
                    <div class="alert alert-<%= alert_class %>">
                        <%= message %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
          <!-- left column -->
          <div class="col-md-12">
            <!-- general form elements -->
            <div class="card card-primary">
              <div class="card-header">
                <h3 class="card-title">Change password</h3>
              </div>
              <!-- /.card-header -->
              <!-- form start -->
              <%= form_with url: handle_change_password_path, local: true do |f| %>
              <div class="card-body">

                <div class="mb-3">
                  <%= f.label :current_password, "Mật khẩu cũ" %>
                  <%= f.password_field :current_password, class: "form-control #{'is-invalid' if @form.errors[:current_password].any?}" %>
                  <% if @form.errors[:current_password].any? %>
                    <div class="invalid-feedback"><%= @form.errors[:current_password].first %></div>
                  <% end %>
                </div>

                <div class="mb-3">
                  <%= f.label :new_password, "Mật khẩu cũ" %>
                  <%= f.password_field :new_password, class: "form-control #{'is-invalid' if @form.errors[:new_password].any?}" %>
                  <% if @form.errors[:new_password].any? %>
                    <div class="invalid-feedback"><%= @form.errors[:new_password].first %></div>
                  <% end %>
                </div>

                <div class="mb-3">
                  <%= f.label :confirm_password, "Mật khẩu cũ" %>
                  <%= f.password_field :confirm_password, class: "form-control #{'is-invalid' if @form.errors[:confirm_password].any?}" %>
                  <% if @form.errors[:confirm_password].any? %>
                    <div class="invalid-feedback"><%= @form.errors[:confirm_password].first %></div>
                  <% end %>
                </div>

                <%= f.submit "Đổi mật khẩu", class: "btn btn-success" %>
                <%= link_to "Quay lại", team_list_path, class: "btn btn-secondary" %>

              </div>
            <% end %>
            </div>
            <!-- /.card -->
          </div>
        </div>
    </div>
</section>