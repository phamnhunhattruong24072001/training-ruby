<!DOCTYPE html>
<html>
<head>
  <title>Reset password</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <!-- AdminLTE CSS -->
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.6.0/css/all.min.css", media: "all" %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css", media: "all" %>

  <%= stylesheet_link_tag "https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css", media: "all" %>
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card">
            <div class="card-body login-card-body">
            <h4 class="login-box-msg">Reset password</h1>
            <div class="row">
                <div class="col-12">
                    <% flash.each do |type, message| %>
                    <% alert_class = type == "notice" ? "success" : "danger" %>
                        <div class="alert alert-<%= alert_class %>">
                            <%= message %>
                        </div>
                    <% end %>
                </div>
            </div>
            <%= form_with url: handle_reset_password_path(@token), local: true do |f| %>
                <div class="input-group mb-3">
                    <%= f.password_field :new_password, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:new_password].any?}", placeholder: "New password" %>
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <% if @form.errors[:new_password].any? %>
                        <div class="invalid-feedback"><%= @form.errors[:new_password].first %></div>
                    <% end %>
                </div>

                <div class="input-group mb-3">
                    <%= f.password_field :confirm_password, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:confirm_password].any?}", placeholder: "Confirm password" %>
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <% if @form.errors[:confirm_password].any? %>
                        <div class="invalid-feedback"><%= @form.errors[:confirm_password].first %></div>
                    <% end %>
                </div>
                
                <div class="row">
                    <!-- /.col -->
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">Submit</button>
                    </div>
                    <!-- /.col -->
                </div>
            <% end %>
            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
</body>
</html>