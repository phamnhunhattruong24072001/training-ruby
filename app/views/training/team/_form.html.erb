<%= form_with model: team, url: @team.persisted? ? team_update_path(@team) : team_create_path, local: true do |f| %>
<div class="card-body">
  <div class="row">
    <div class="mb-3 col-12">
        <div class="form-group mb-3">
            <%= f.label :name, "Full name" %>
            <%= f.text_field :name, autofocus: true, class: "form-control #{'is-invalid' if @form.errors[:name].any?}", placeholder: "Full name" %>
            <% if @form.errors[:name].any? %>
                <div class="invalid-feedback"><%= @form.errors[:name].first %></div>
            <% end %>
        </div>
    </div>
    <div class="mb-3 col-12">
        <div class="form-group mb-3">
            <%= f.label :description, "Mô tả" %>
            <%= f.text_area :description, rows: 3, class: "form-control" %>
        </div>
    </div>
    <div class="mb-3 col-12">
      <%= f.submit "Submit", class: "btn btn-success" %>
      <%= link_to "Quay lại", team_list_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
<% end %>
